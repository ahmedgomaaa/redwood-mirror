{
  "name":"redwood-mirror",
  "version":"1.0.0",
  "private":true,
  "type":"module",
  "engines":{"node":">=24 <25"},
  "scripts":{
    "start":"node --env-file-if-exists=.env server.mjs",
    "test":"node tests/unit.mjs && node tests/security.mjs && node tests/failure.mjs && node tests/production.mjs && node tests/backup.mjs && node tests/crash.mjs && node test.mjs && node test-story.mjs && node tests/viewport.mjs",
    "test:unit":"node tests/unit.mjs",
    "test:security":"node tests/security.mjs",
    "test:ui":"node test.mjs && node test-story.mjs",
    "test:load":"node tests/load.mjs",
    "backup":"node --env-file-if-exists=.env scripts/backup.mjs",
    "check:release":"node scripts/check-release.mjs",
    "package:release":"node scripts/check-release.mjs && node scripts/package-release.mjs"
  },
  "devDependencies":{"playwright":"1.63.0"}
}
