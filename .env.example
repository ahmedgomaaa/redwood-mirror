# Local development: localhost only. Copy this to .env; never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
ROUND_SECONDS=180
MAX_PLAYERS=100
ROOM_CODE=MIRROR
REQUIRE_INVITES=false
ALLOW_DEMO_BOTS=true
# Production: NODE_ENV=production, HOST=0.0.0.0, HTTPS origin without trailing slash.
# PUBLIC_ORIGIN=https://game.example.com
# MIRROR_ADMIN_TOKEN=generate-a-random-secret-do-not-use-this-example
# REQUIRE_INVITES=true
# ALLOW_DEMO_BOTS=false
